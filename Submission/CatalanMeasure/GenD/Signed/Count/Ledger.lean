/-- The count pieces. -/
def pieces : List (Spec × Cnt) :=
  CaseBlock00.pieces ++ CaseBlock01.pieces ++ CaseBlock02.pieces ++ CaseBlock03.pieces ++ CaseBlock04.pieces ++ CaseBlock05.pieces ++ CaseBlock06.pieces ++ CaseBlock07.pieces

theorem pieces_ok : ∀ c ∈ pieces, c.1.P = design ∧ c.1.Check = true ∧ c.2.ok c.1 = true := by
  intro c hc
  simp only [pieces, List.mem_append] at hc
  rcases hc with (((((((h | h) | h) | h) | h) | h) | h) | h)
  · exact CaseBlock00.pieces_ok c h
  · exact CaseBlock01.pieces_ok c h
  · exact CaseBlock02.pieces_ok c h
  · exact CaseBlock03.pieces_ok c h
  · exact CaseBlock04.pieces_ok c h
  · exact CaseBlock05.pieces_ok c h
  · exact CaseBlock06.pieces_ok c h
  · exact CaseBlock07.pieces_ok c h

-- kcost: 5.6 s measured
theorem ledger_ok : ledgerOK (pieces.map cntRow) baseRows ledgerRows = true := by decide +kernel

-- kcost: 0.4 s measured
theorem ledger_gain : (220607 / 10000 : ℚ) ≤ (ledgerRows.map Row.area).sum := by decide +kernel

noncomputable section

/-- **The content bound of the ledger**, given certificates for `baseRows`. -/
theorem content (fams0 : List (NullityLB design))
    (hold : ∀ o ∈ baseRows, ∃ lb ∈ fams0, WinCert lb o.win) :
    ∃ (lbC : NullityLB design) (gain : ℝ), (220607 / 10000 : ℝ) ≤ gain ∧
      ∀ ε : ℝ, 0 < ε → ∀ᶠ N : ℕ in atTop,
        Real.log ((canonicalNormalizer Signed.dc58.toParameters Signed.dc58.admissible
          (famLB (lbC :: fams0)) 79 Signed.RouteI.dc58_normalizer_cut).D N : ℝ) ≤
          (gDg gain + ε) * (N : ℝ) ^ 2 :=
  content_of_ledger pieces pieces_ok fams0 baseRows ledgerRows hold ledger_ok ledger_gain

end
