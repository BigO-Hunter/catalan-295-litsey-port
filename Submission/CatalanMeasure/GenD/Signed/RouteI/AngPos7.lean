  decide +kernel

theorem haux_eq : AngAux.auxList Sign.pos 7 DD = auxL := by
  -- kcost: 16 streams x 384 steps, 385 Rat floors; about 6 s at 32 streams (measured).
  decide +kernel

theorem heps : eGpos 192 127 Hb1 cbb1 + AngAux.eAq Sign.pos DD + AngAux.tailQ Sign.pos DD.sh ≤ epsQ := by
  -- kcost: 2 x 16-term rational sums, one rational 385th power; under 1 s.
  decide +kernel

theorem hconv : AngularCap.combineP (AngularCap.Nlist glL) auxL (2 ^ 192 * 2 ^ (glL.length - 1)) AngAux.adN = pL := by
  -- kcost: Nlist on 128 coefficients, O(128^2) big additions; about 1 s (measured).
  decide +kernel

theorem hkron : KronSquare.KronSquare KD pL qL [] rL ((2 ^ 192 * 2 ^ (glL.length - 1)) * AngAux.adN) (29557/200000) epsQ := by
  -- kcost: packed square of 256 coefficients at 770 bits and a 511-term identity; about 11 s (measured).
  decide +kernel

open CatalanMeasure.Signed.ChebSquare in
theorem hmarg : l1 rL.tail < rL.headD 0 := by
  -- kcost: 511 absolute values; about 1 s (measured).
  decide +kernel

theorem gas_ok : AngularSource.Binning (capSource.gas Sign.pos) (binsY TL) ∧
    ∑ j ∈ Finset.range (127 + 1), |AngularCap.gasA capSource Sign.pos 7 (binsY TL) j -
      (((glFast 192 alD (TL.map BD.s0) cnumD 127).getD j 0 : ℤ) : ℝ) / ((2 ^ 192 : ℕ) : ℝ)| ≤
    ((eGpos 192 127 Hb1 cbb1 : ℚ) : ℝ) :=
  gas_final_pos capSource 7 part_pos mom_spec
    (rad_enc capSource 7 (capSource_sigma 7) rad_ok) a1_ok const_ok cb1_ok 127

/-- **The certificate** of the positive species at radius index 7. -/
def angPos7 : AngularCap.AngRadiusCert capSource Sign.pos 7 (29557/200000) :=
  AngAux.angRadius_of_kron Sign.pos 7 26 (29557/200000) (binsY TL) gas_ok.1 127 (by decide)
    glL (2 ^ 192) (by positivity) hgl_len hgl_ne (eGpos 192 127 Hb1 cbb1)
    (by rw [← hgl_eq]; exact gas_ok.2)
    DD shared_ok (AngAux.auxRadOK_of_check aux_rad) auxL pL qL [] rL haux_eq epsQ heps hconv KD hkron hmarg

end

