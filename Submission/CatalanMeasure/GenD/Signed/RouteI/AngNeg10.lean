theorem rad_ok : radPass 192 NRD (sigQ 10) rHD = true := by
  -- kcost: exp series of 34 terms, twice, at 192-bit target; under 1 s.
  decide +kernel

theorem a1_ok : alphaAll (alpha1OK 192 rHD eBu (kAD : ℚ)) TL alD = true := by
  -- kcost: 29 bins, about 15 Rat operations each; under 1 s.
  decide +kernel

theorem a2_ok : alphaAll (alpha2OK 192 rHD) TL al2D = true := by
  -- kcost: 29 bins, about 10 Rat operations each; under 1 s.
  decide +kernel

theorem const_ok : constOKneg 192 eBu rHD Hb1 Hb2 TL cnumD = true := by
  -- kcost: 58 logs of rationals (about 20 Rat operations each) plus sums; a few s.
  decide +kernel

theorem cb1_ok : cb1 192 eAu eBu (kAD : ℚ) rHD TL ≤ cbb1 := by
  -- kcost: 29 bins, a dozen Rat operations each; under 1 s.
  decide +kernel

theorem cb2_ok : cb2 192 eAu eBu rHD TL ≤ cbb2 := by
  -- kcost: 29 bins, a dozen Rat operations each; under 1 s.
  decide +kernel

theorem hgl_eq : glFastNeg 192 alD al2D (TL.map BD.s0) cnumD 127 = glL := by
  -- kcost: 2 x 29 bins x 128 power steps in 192-bit integer arithmetic; about 1 s at 29 bins (measured).
  decide +kernel

theorem hgl_len : glL.length ≤ 127 + 1 := by
  -- kcost: list length, 128 steps.
  decide +kernel

theorem hgl_ne : glL ≠ [] := by
  -- kcost: one constructor test.
  decide +kernel

theorem aux_rad : AngAux.auxRadCheck Sign.neg 26 10 DD = true := by
  -- kcost: 32 streams, 2 exp enclosures of 26 terms each; under 1 s.
  decide +kernel

theorem haux_eq : AngAux.auxList Sign.neg 10 DD = auxL := by
  -- kcost: 32 streams x 384 steps, 385 Rat floors; about 6 s at 32 streams (measured).
  decide +kernel

theorem heps : eGneg 192 127 Hb1 Hb2 cbb1 cbb2 + AngAux.eAq Sign.neg DD + AngAux.tailQ Sign.neg DD.sh ≤ epsQ := by
  -- kcost: 2 x 32-term rational sums, one rational 385th power; under 1 s.
  decide +kernel

theorem hconv : AngularCap.combineP (AngularCap.Nlist glL) auxL (2 ^ 192 * 2 ^ (glL.length - 1)) AngAux.adN = pL := by
  -- kcost: Nlist on 128 coefficients, O(128^2) big additions; about 1 s (measured).
  decide +kernel

theorem hkron : KronSquare.KronSquare KD pL qL [] rL ((2 ^ 192 * 2 ^ (glL.length - 1)) * AngAux.adN) (5489/100000) epsQ := by
  -- kcost: packed square of 128 coefficients at 769 bits and a 385-term identity; about 4 s (measured).
  decide +kernel

