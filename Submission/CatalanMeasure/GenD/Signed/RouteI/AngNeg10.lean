theorem hmarg : l1 rL.tail < rL.headD 0 := by
  -- kcost: 385 absolute values; about 1 s (measured).
  decide +kernel

theorem gas_ok : AngularSource.Binning (capSource.gas Sign.neg) ((binsY TL).map reflectL) ∧
    ∑ j ∈ Finset.range (127 + 1), |AngularCap.gasA capSource Sign.neg 10 ((binsY TL).map reflectL) j -
      (((glFastNeg 192 alD al2D (TL.map BD.s0) cnumD 127).getD j 0 : ℤ) : ℝ) / ((2 ^ 192 : ℕ) : ℝ)| ≤
    ((eGneg 192 127 Hb1 Hb2 cbb1 cbb2 : ℚ) : ℝ) :=
  gas_final_neg capSource 10 part_neg capSource_neg_hi (capSource_neg_w CatalanMeasure.GenD.Signed.RouteI.AngMomNeg32.gasw_pos) mom_spec
    (rad_enc capSource 10 (capSource_sigma 10) rad_ok) a1_ok a2_ok const_ok cb1_ok cb2_ok 127

/-- **The certificate** of the negative species at radius index 10. -/
def angNeg10 : AngularCap.AngRadiusCert capSource Sign.neg 10 (5489/100000) :=
  AngAux.angRadius_of_kron Sign.neg 10 26 (5489/100000) ((binsY TL).map reflectL) gas_ok.1 127 (by decide)
    glL (2 ^ 192) (by positivity) hgl_len hgl_ne (eGneg 192 127 Hb1 Hb2 cbb1 cbb2)
    (by rw [← hgl_eq]; exact gas_ok.2)
    DD shared_ok (AngAux.auxRadOK_of_check aux_rad) auxL pL qL [] rL haux_eq epsQ heps hconv KD hkron hmarg

end

