public import Submission.CatalanCore.Uniform.Bank.SeventhsContent.Level3Data.U1
public import Submission.CatalanCore.Uniform.Bank.SeventhsContent.Level3Data.U2
public import Submission.CatalanCore.Uniform.Bank.SeventhsContent.Level3Data.U3
public import Submission.CatalanCore.Uniform.Bank.SeventhsContent.Level3Data.U4
public import Submission.CatalanCore.Uniform.Bank.SeventhsContent.Level3Data.U5
public import Submission.CatalanCore.Uniform.Bank.SeventhsContent.Level3Data.U6
public import Submission.CatalanCore.Uniform.Content.BankShared.Check.Mass

@[expose] public section
set_option Elab.async false
set_option maxRecDepth 100000

/-! # Data: the sevenths UF bank for the bank check (lane C1L)

Generated by `scripts/claude/bank/check/emit_bank_uf.py sevenths`: the header `bankHead` (`AutoData/Head`) with the
templates of `AutoData/U<j>` and the finite content constant `Λ_fin` (prefix truncation `n = 150`).  The template
checks transport from `bankHead` (`tmplOK_withTmpls`); (D1, D6) use the template masses `bankMasses` proved in
`U<j>` (`classOK_of_masses`); `bank_check : check bankData = true`. -/

namespace CatalanCore.Uniform.Bank.SeventhsContent.Level3Auto
open CatalanCore.Uniform.Content.BankShared.Check

/-- The sevenths UF bank data, with its finite `Λ_fin`. -/
def bankData : BankData := { bankHead with Λ := qq  , tmpls := [(1, tmpl1), (2, tmpl2), (3, tmpl3), (4, tmpl4), (5, tmpl5), (6, tmpl6)] }

theorem tmpl1_okD : tmplOK bankData 1 tmpl1 = true :=
  tmplOK_withTmpls bankHead _ _ 1 tmpl1 tmpl1_ok

theorem tmpl2_okD : tmplOK bankData 2 tmpl2 = true :=
  tmplOK_withTmpls bankHead _ _ 2 tmpl2 tmpl2_ok

theorem tmpl3_okD : tmplOK bankData 3 tmpl3 = true :=
  tmplOK_withTmpls bankHead _ _ 3 tmpl3 tmpl3_ok

theorem tmpl4_okD : tmplOK bankData 4 tmpl4 = true :=
  tmplOK_withTmpls bankHead _ _ 4 tmpl4 tmpl4_ok

theorem tmpl5_okD : tmplOK bankData 5 tmpl5 = true :=
  tmplOK_withTmpls bankHead _ _ 5 tmpl5 tmpl5_ok

theorem tmpl6_okD : tmplOK bankData 6 tmpl6 = true :=
  tmplOK_withTmpls bankHead _ _ 6 tmpl6 tmpl6_ok

/-- The catalogue of `bankData` in the shape of `catValid_bankUFwP`. -/
theorem bankData_cat : bankData.cat = ((tableT ++ ([brLP1, brLP2w, brRank, brS] ++
    bankWins.map (fun w => brWin w.1 w.2)) ++ (bankPres.map (fun x => brPre x.1 x.2.1 x.2.2))) ++ [CatalanCore.Uniform.Content.UFSimple.WrapCheck.brWrap]) ++ CatalanCore.Uniform.Content.UFSimple.prefixBranches 24 :=
  by
  simp only [bankData, bankHead, bankExtra, BankData.cat, List.append_assoc]

/-- The template masses. -/
def bankMasses : List (ℕ × ℚ) := [(1, ( /  : ℚ)), (2, ( /  : ℚ)), (3, ( /  : ℚ)), (4, ( /  : ℚ)), (5, ( /  : ℚ)), (6, ( /  : ℚ))]

theorem bank_masses : ∀ x ∈ bankData.tmpls, x.2.mass bankData.α0 = massOf bankMasses x.1 := by
  show ∀ x ∈ [(1, tmpl1), (2, tmpl2), (3, tmpl3), (4, tmpl4), (5, tmpl5), (6, tmpl6)], x.2.mass (qq 13 6) = massOf bankMasses x.1
  simp only [List.forall_mem_cons, List.not_mem_nil, false_implies, implies_true, and_true]
  exact ⟨tmpl1_mass.trans rfl,
    tmpl2_mass.trans rfl,
    tmpl3_mass.trans rfl,
    tmpl4_mass.trans rfl,
    tmpl5_mass.trans rfl,
    tmpl6_mass.trans rfl⟩

set_option profiler true in
theorem bank_params : checkParams bankData = true := by decide +kernel

set_option profiler true in
theorem bank_classesM : bankData.members.all (classOKM bankData bankMasses) = true := by decide +kernel

theorem bank_classes : bankData.members.all (classOK bankData) = true := by
  rw [show classOK bankData = classOKM bankData bankMasses from
    funext (classOK_of_masses bankData bankMasses bank_masses)]
  exact bank_classesM

theorem bank_tmpls : bankData.tmpls.all (fun x => tmplOK bankData x.1 x.2) = true := by
  show [(1, tmpl1), (2, tmpl2), (3, tmpl3), (4, tmpl4), (5, tmpl5), (6, tmpl6)].all (fun x => tmplOK bankData x.1 x.2) = true
  simp only [List.all_cons, List.all_nil, tmpl1_okD, tmpl2_okD, tmpl3_okD, tmpl4_okD, tmpl5_okD, tmpl6_okD, Bool.and_self]

/-- **The bank check accepts the sevenths UF data.** -/
theorem bank_check : check bankData = true := by
  unfold check
  rw [bank_params, bank_tmpls, bank_classes]
  rfl

/-- The finite content constant. -/
theorem bankData_Λ : bankData.Λ = ( /
     : ℚ) := by
  decide +kernel

end CatalanCore.Uniform.Bank.SeventhsContent.Level3Auto
