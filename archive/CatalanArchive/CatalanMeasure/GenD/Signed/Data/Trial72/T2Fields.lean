-- kcost: 20000 rational steps; 2.0000s modeled at 100 us/step; 1 decide +kernel checks.
theorem frFq_eq : frFq = frFQ trial rT aT := by decide +kernel

/-- **SN**: `fNegLim = fieldTower snFq + snK` (all `x`). -/
theorem hidSN (x : ℝ) :
    fNegLim trial.form (rfQ (3 / 8) (1 / 9) (97 / 72)) x =
      fieldTower snFq (poleFn snFq.poles) 0 x + snK trial :=
  hid_sn trial (fun y => (fval_rf _ _ _ y).symm) vS_eq pT_eq aS_eq rS_eq rr_eq rfl har snFq_eq x

/-- **SP**: `fPosLim = fieldTower spFq + (dilated block) + spK + spike cost` (`x ≠ 0`). -/
theorem hidSP {csL θL x : ℝ} (hx : x ≠ 0) :
    fPosLim trial.form (rfQ (3 / 8) (1 / 9) (97 / 72)) ((5 / 18 : ℚ) : ℝ) (fQ bsL) bsL.length csL θL x =
      fieldTower spFq (poleFn spFq.poles) 0 x + lfieldTower (dilTermsS trial.qT trial.qTn) 0 x + spK trial +
        csL * (if 1 - θL < x then 1 else 0) :=
  hid_sp trial (fun y => (fval_rf _ _ _ y).symm) vS_eq pT_eq aS_eq rS_eq bS_eq rr_eq rfl har spFq_eq hx

/-- **SC**: the column field. -/
theorem hidSC (s : ℝ) :
    cfQ (11 / 72) (1 / 18) s + 2 * trial.form.v.Tform s = fieldTower scFq (poleFn scFq.poles) 0 s + scK trial :=
  hid_sc trial (fun y => (fval_cf _ _ y).symm) vT_eq scFq_eq s

/-- **σ⁻**: `fNegMLim` with `RmL = -(11/12) log (1 + x²)`. -/
theorem hidSM (x : ℝ) :
    fNegMLim trial.form (rmQ (11 / 12)) x = fieldTower smFq (poleFn smFq.poles) 0 x + smK trial :=
  hid_sm trial (fun y => (fval_rm _ y).symm) pT_eq aS_eq rS_eq rr_eq rfl har smFq_eq x

/-- **σ⁺**: `fPosMSLim` plus the Lemma R′ remainder `remC(1 - 2η) α (-log (1 - x²))`, `remC = 11/8`. -/
theorem hidSPM {csL θL x : ℝ} (hx : x ∈ Set.Ioo (0 : ℝ) 1) :
    fPosMSLim trial.form (rmQ (11 / 12)) ((5 / 18 : ℚ) : ℝ) (fQ bsL) bsL.length csL θL x +
        ((11 / 8 : ℚ) : ℝ) * (alpha : ℝ) * (-Real.log (1 - x ^ 2)) =
      fieldTower spmFq (poleFn spmFq.poles) 0 x + lfieldTower (dilTermsS trial.qT trial.qTn) 0 x + spmK trial +
        csL * (if 1 - θL < x then 1 else 0) :=
  hid_spm trial (fun y => (fval_rm _ y).symm) pT_eq aS_eq rS_eq bS_eq rr_eq rfl har spmFq_eq hx

/-- **Near**: `fNearMSLim` with `RnL = -(11/12) log (1 + x²) + (5/6) log |x|`, `β = α`. -/
theorem hidNEAR {csL θL x : ℝ} (hx : x ∈ Set.Ioo (0 : ℝ) 1) :
    fNearMSLim trial.form (rnQ (11 / 12) (5 / 6)) (alpha : ℝ) (alpha : ℝ) ((5 / 18 : ℚ) : ℝ)
        (fQ bsL) bsL.length csL θL x =
      fieldTower nearFq (poleFn nearFq.poles) 0 x +
        lfieldTower (scaleL (-1) (reflL (dilTermsS trial.qF trial.qFn))) 0 x + nearK trial alpha alpha +
        csL * (if 1 - θL < x then 1 else 0) :=
  hid_near trial (fun y => (fval_rn _ _ y).symm) aS_eq rS_eq bS_eq rfl har nearFq_eq hx

/-- **FR**: the Frostman field at `τ = 1`. -/
theorem hidFR (x : ℝ) : frLim trial.form x = fieldTower frFq (poleFn frFq.poles) 0 x + frK trial :=
  hid_fr trial rT_eq aT_eq frFq_eq x

