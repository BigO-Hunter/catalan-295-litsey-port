theorem coeff_checked : sbPosCoeffs bs 0 = coeffs := by
  -- kcost: 0.800 s estimated;120 coefficient divisions/scales and conservative sign operations.
  decide +kernel

theorem positive_checked : coeffs.all (fun c => decide (0 ≤ c)) = true := by
  -- kcost: 0.012 s estimated;120 rational comparisons.
  decide +kernel

theorem S1_checked : sbHorQ 1 coeffs = S1 := by
  -- kcost: 0.050 s estimated;120 finite Horner stages at one.
  decide +kernel

theorem at_one : barrierTrialS (bSeq bs) (-1) = (S1 : ℝ) := by
  rw [barrierTrialS_horner,coeff_checked]
  have he : ((sbHorQ 1 coeffs : ℚ) : ℝ) = CatalanMeasure.Cert.lpEval coeffs 1 := by
    simpa only [Rat.cast_one] using sbHorQ_cast (1 : ℚ) coeffs
  rw [← he]
  simp only [one_mul]
  exact_mod_cast S1_checked

theorem global_maximum : ∀ y ∈ Set.Icc (0 : ℝ) 1,
    2*barrierTrialS (bSeq bs) (-y) ≤ 2*(S1 : ℝ) := by
  intro y hy
  have hc : (sbPosCoeffs bs 0).all (fun c => decide (0 ≤ c)) = true := by
    rw [coeff_checked]; exact positive_checked
  have h := barrierTrialS_neg_mono hc hy.1 hy.2
  rw [at_one] at h
  linarith

theorem hDe {M : ℕ} (z : Fin M → ℝ) {L ρ : ℝ}
    (hlo : L ≤ barrierTrialS (bSeq bs) (-ρ))
    (hz : ∀ p, z p ∈ Set.Icc (0 : ℝ) 1) :
    ∀ p, barrierTrialS (bSeq bs) (-(z p)) - barrierTrialS (bSeq bs) (-ρ) ≤ (S1 : ℝ) - L :=
  spikeCost_hDe_of_global z global_maximum hlo hz

