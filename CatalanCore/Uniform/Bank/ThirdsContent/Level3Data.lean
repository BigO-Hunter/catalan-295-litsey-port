@[expose] public section
set_option Elab.async false
set_option maxRecDepth 100000

/-! # Data: the thirds UF bank for the bank check (lane C1L)

Generated by `scripts/claude/bank/check/emit_bank_uf.py thirds`: the header `bankHead` (`AutoData/Head`) with the
templates of `AutoData/U<j>` and the finite content constant `Λ_fin` (prefix truncation `n = 150`).  The template
checks transport from `bankHead` (`tmplOK_withTmpls`); `bank_check : check bankData = true`. -/

namespace CatalanCore.Uniform.Bank.ThirdsContent.Level3Auto
open CatalanCore.Uniform.Content.BankShared.Check

/-- The thirds UF bank data, with its finite `Λ_fin`. -/
def bankData : BankData := { bankHead with Λ := qq 66320352040959336689215025790264507510134170310185692952096420013290151586057234711501632396019809969627753832426591293571606182798837 20032704081776859162954607942100839655908955284401122975927379228411852554696943421051896893663588012379346085358080009951560320000000, tmpls := [(1, tmpl1), (2, tmpl2)] }

theorem tmpl1_okD : tmplOK bankData 1 tmpl1 = true :=
  tmplOK_withTmpls bankHead _ _ 1 tmpl1 tmpl1_ok

theorem tmpl2_okD : tmplOK bankData 2 tmpl2 = true :=
  tmplOK_withTmpls bankHead _ _ 2 tmpl2 tmpl2_ok

/-- The catalogue of `bankData` in the shape of `catValid_bankUFwP`. -/
theorem bankData_cat : bankData.cat = (tableT ++ ([brLP1, brLP2w, brRank, brS] ++
    bankWins.map (fun w => brWin w.1 w.2)) ++ (bankPres.map (fun x => brPre x.1 x.2.1 x.2.2))) ++ [CatalanCore.Uniform.Content.UFSimple.WrapCheck.brWrap] :=
  by
  simp only [bankData, bankHead, bankExtra, BankData.cat, List.append_assoc]

set_option profiler true in
theorem bank_params : checkParams bankData = true := by decide +kernel

set_option profiler true in
theorem bank_classes : bankData.members.all (classOK bankData) = true := by decide +kernel

theorem bank_tmpls : bankData.tmpls.all (fun x => tmplOK bankData x.1 x.2) = true := by
  show [(1, tmpl1), (2, tmpl2)].all (fun x => tmplOK bankData x.1 x.2) = true
  simp only [List.all_cons, List.all_nil, tmpl1_okD, tmpl2_okD, Bool.and_self]

/-- **The bank check accepts the thirds UF data.** -/
theorem bank_check : check bankData = true := by
  unfold check
  rw [bank_params, bank_tmpls, bank_classes]
  rfl

/-- The finite content constant. -/
theorem bankData_Λ : bankData.Λ = (66320352040959336689215025790264507510134170310185692952096420013290151586057234711501632396019809969627753832426591293571606182798837 /
    20032704081776859162954607942100839655908955284401122975927379228411852554696943421051896893663588012379346085358080009951560320000000 : ℚ) := by
  decide +kernel

end CatalanCore.Uniform.Bank.ThirdsContent.Level3Auto
