def fromOdd (m : Int) (e : Nat) (neg : Bool) : Int :=
  if neg then -(m * 2 ^ e) else m * 2 ^ e

def fromWords : List Int → Int
  | [] => 0
  | a :: as => a + (2 : Int) ^ (48 : Nat) * fromWords as

