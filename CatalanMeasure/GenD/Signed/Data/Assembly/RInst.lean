    iRRq / 2 - Lq / 2

theorem rLim_cast (η l2 Vq Pq Rq Aq raq iRRq Lq γ Sup σ Bq : ℚ) :
    rLim (η : ℝ) (l2 : ℝ) (Vq : ℝ) (Pq : ℝ) (Rq : ℝ) (Aq : ℝ) (raq : ℝ) (iRRq : ℝ) (Lq : ℝ) (γ : ℝ)
