module

public import CatalanMeasure.GenD.Signed.Data.Assembly.Data
public import CatalanMeasure.GenD.Signed.Data.Assembly.RInst
public import CatalanMeasure.GenD.Signed.Data.Assembly.CurvInst

@[expose] public section

/-!
# Constant rows from the actual endpoint norm and curvature certificates

The numeric applications are generated by phase2-data/consts/rowsconst_emit.py.
-/

namespace CatalanMeasure.GenD.Signed.Data.Assembly

open Set Filter Topology
open CatalanMeasure.Signed OAI.InternalCatalan CatalanMeasure.Parametric

noncomputable section

namespace Generic

/-- Certified constant and curvature rows for the same endpoint families. -/
structure ConstantRows (dc : DesignConst) (I : Inputs dc) where
  rA : Fin 2 → ℝ
  rB : Fin 2 → ℝ
  κc : Fin 2 → ℝ
  hrA : ∀ i {ε : ℝ}, 0 < ε → ∀ᶠ N : ℕ in atTop,
    (I.DA i N).constTotal (dc.n0 * N) - (I.DA i N).constant ≤ rA i + ε
  hrB : ∀ i {ε : ℝ}, 0 < ε → ∀ᶠ N : ℕ in atTop,
    (I.DB i N).constTotal (dc.n0 * N) - (I.DB i N).constant ≤ rB i + ε
  hκ : ∀ i {ε : ℝ}, 0 < ε → ∀ᶠ N : ℕ in atTop,
    κc i - ε ≤ curvQ (I.DA i N) (I.DB i N) (dc.n0 * N)

/-- The algebraic problem constant, independent of certificate outputs. -/
def cP (dc : DesignConst) : Fin 2 → ℝ → ℝ :=
  fun _ α => Glue410.constantLim dc.toParameters α

theorem hcP (dc : DesignConst) (I : Inputs dc) :
    ∀ i, ∀ α ∈ Icc (I.lo i) (I.hi i), Glue410.constantLim dc.toParameters α ≤ cP dc i α :=
  fun _ _ _ => le_rfl

/-- Actual rational outputs plus their analytic certificates provide the rows. -/
def constantRows_of_cert (dc : DesignConst) (I : Inputs dc)
    (rrA rrB kc : Fin 2 → ℚ)
    (hA : ∀ i {ε : ℝ}, 0 < ε → ∀ᶠ N : ℕ in atTop,
      (I.DA i N).constTotal (dc.n0 * N) - (I.DA i N).constant ≤ (rrA i : ℝ) + ε)
    (hB : ∀ i {ε : ℝ}, 0 < ε → ∀ᶠ N : ℕ in atTop,
      (I.DB i N).constTotal (dc.n0 * N) - (I.DB i N).constant ≤ (rrB i : ℝ) + ε)
    (hK : ∀ i, ∀ᶠ N : ℕ in atTop,
      (kc i : ℝ) ≤ curvQ (I.DA i N) (I.DB i N) (dc.n0 * N)) : ConstantRows dc I where
  rA := fun i => (rrA i : ℝ)
  rB := fun i => (rrB i : ℝ)
  κc := fun i => (kc i : ℝ)
  hrA := hA
  hrB := hB
  hκ := by
    intro i ε hε
    filter_upwards [hK i] with N hN
    linarith

end Generic

/-- `cP i α := constantLim P410 α`. -/
def cP410 : Fin 2 → ℝ → ℝ := fun _ α => Glue410.constantLim P410 α

theorem hcP410 : ∀ i, ∀ α ∈ Icc (lo410 i) (hi410 i), Glue410.constantLim P410 α ≤ cP410 i α :=
  fun _ _ _ => le_rfl

def rA410 : Fin 2 → ℝ := fun i => ((![rr0, rr1] i : ℚ) : ℝ)
def rB410 : Fin 2 → ℝ := fun i => ((![rr1, rr2] i : ℚ) : ℝ)
def κc410 : Fin 2 → ℝ := fun i => ((![kc01, kc12] i : ℚ) : ℝ)

theorem hrA410 : ∀ i {ε : ℝ}, 0 < ε → ∀ᶠ N : ℕ in atTop,
    (DA410 i N).constTotal (58 * N) - (DA410 i N).constant ≤ rA410 i + ε := by
  intro i ε hε
  fin_cases i
  · exact hr_0 ε hε
  · exact hr_1 ε hε

theorem hrB410 : ∀ i {ε : ℝ}, 0 < ε → ∀ᶠ N : ℕ in atTop,
    (DB410 i N).constTotal (58 * N) - (DB410 i N).constant ≤ rB410 i + ε := by
  intro i ε hε
  fin_cases i
  · exact hr_1 ε hε
  · exact hr_2 ε hε

theorem hκ410 : ∀ i {ε : ℝ}, 0 < ε → ∀ᶠ N : ℕ in atTop,
    κc410 i - ε ≤ curvQ (DA410 i N) (DB410 i N) (58 * N) := by
  intro i ε hε
  fin_cases i
  · filter_upwards [curv_ge_01] with N hN
    show (kc01 : ℝ) - ε ≤ curvQ (famD X0 N) (famD X1 N) (58 * N)
    linarith
  · filter_upwards [curv_ge_12] with N hN
    show (kc12 : ℝ) - ε ≤ curvQ (famD X1 N) (famD X2 N) (58 * N)
    linarith

/-- D58 values assembled with their existing analytic certificates. -/
def constantRows410 : Generic.ConstantRows dc58 inputs410 :=
  Generic.constantRows_of_cert dc58 inputs410
    ![rr0, rr1] ![rr1, rr2] ![kc01, kc12] hrA410 hrB410
    (fun i => by
      fin_cases i
      · exact curv_ge_01
      · exact curv_ge_12)

end

end CatalanMeasure.GenD.Signed.Data.Assembly
