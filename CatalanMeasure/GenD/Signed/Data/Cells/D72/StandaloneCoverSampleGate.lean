theorem coverOn (f : ℝ → ℝ) (P : ℝ → Prop) (T : ℝ) (lo hi : ℚ)
    (ps : List (ℚ × ℚ)) (hn : ps ≠ []) (hc : pieceCover hi lo ps = true)
