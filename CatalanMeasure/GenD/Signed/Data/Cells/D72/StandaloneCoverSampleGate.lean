    ∀ x ∈ Icc (lo : ℝ) (hi : ℝ), P x → f x ≤ T := by
  classical
  have h := pieceCover_bound hi (fun x => if P x then f x else T) T lo ps hn hc
    (by
      intro p hmem x hx
      by_cases hP : P x
      · simpa [hP] using hp p hmem x hx hP
      · simp [hP])
  intro x hx hP
  simpa [hP] using h x hx
