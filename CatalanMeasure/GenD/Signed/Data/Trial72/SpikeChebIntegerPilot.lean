/-- Carry the Chebyshev recurrence in integers. The first two states are
unscaled; the accumulator and twice the input coefficients have common
denominator d. -/
def go : List ℤ → List ℤ → List ℤ → List ℤ → List ℤ
  | [], _, _, acc => acc
  | c :: cs, t, t1, acc =>
    go cs t1 (zAdd (0 :: zSmul 2 t1) (zSmul (-1) t)) (zAdd acc (zSmul c t1))

theorem eval_go (d : ℤ) (hd : d ≠ 0) (x : ℝ) :
    ∀ (cs t t1 acc : List ℤ) (p p1 a : List ℚ),
    lpEval p x = zv t x → lpEval p1 x = zv t1 x →
    lpEval a x = zv acc x / (d : ℝ) →
    lpEval (chebGo (cs.map fun c : ℤ => (c : ℚ) / (2 * d)) p p1 a) x =
      zv (go cs t t1 acc) x / (d : ℝ)
  | [], _, _, _, _, _, _, _, _, ha => ha
  | c :: cs, t, t1, acc, p, p1, a, h, h1, ha => by
    simp only [List.map_cons, chebGo, go]
    apply eval_go d hd x cs t1 _ _ p1 _ _ h1
    · rw [lpEval_add, lpEval_X2, lpEval_smul, h, h1, zv_add, zv_cons, zv_smul, zv_smul]
      push_cast
      ring
    · rw [lpEval_add, lpEval_smul, ha, h1, zv_add, zv_smul]
      push_cast
      have hd' : (d : ℝ) ≠ 0 := by exact_mod_cast hd
      field_simp
      <;> ring

theorem chebPs_eq (bs : List ℚ) (cs pn : List ℤ) (d : ℤ) (hd : d ≠ 0)
    (hbs : bs = cs.map (fun c : ℤ => (c : ℚ) / (2 * d)))
    (hpn : go cs [1] [0, 1] [d] = pn) (x : ℝ) :
    chebPs (bSeq bs) x = zv pn x / (d : ℝ) := by
  rw [chebPs_bSeq, hbs, chebMono, ← hpn]
  apply eval_go d hd x cs [1] [0, 1] [d] [1] [0, 1] [1]
  · simp [lpEval_cons, zv_cons, zv_nil]
  · simp [lpEval_cons, zv_cons, zv_nil]
  · have hd' : (d : ℝ) ≠ 0 := by exact_mod_cast hd
    simp [lpEval_cons, zv_cons, zv_nil, hd']

end
end CatalanMeasure.GenD.Signed.Data.Trial72.SpikeChebInteger

