theorem signs_checked : 0 < sr2 ∧ 0 < srt ∧ 0 ≤ ap := by decide +kernel

def P2 (x : ℝ) : ℝ := zv V2 x / (D2 : ℝ)
def Pt (x : ℝ) : ℝ := zv Vt x / (Dt : ℝ)

theorem weighted_dom (h2 : mobCell V2 3 (-16) (-15) = MP2)
    (ht : mobCell Vt 3 (-16) (-15) = MPt) {x : ℝ}
    (hx : x ∈ Set.Icc (((-16 : ℤ) : ℝ)/2^3) (((-15 : ℤ) : ℝ)/2^3)) :
    (sr2 : ℝ) * P2 x ≤ (srt : ℝ) * Pt x := by
  have hd := mob_dom_Icc (p := V2) (q := Vt) (m := 120) (a := W2) (b := Wt)
    (by decide +kernel) (by decide +kernel) h2 ht (by decide +kernel) dominance_checked hx
  have ha : (W2 : ℝ) = (common : ℝ) * (sr2 : ℝ) / (D2 : ℝ) := by
    exact_mod_cast weights_checked.1
  have hb : (Wt : ℝ) = (common : ℝ) * (srt : ℝ) / (Dt : ℝ) := by
    exact_mod_cast weights_checked.2.1
  have hc : 0 < (common : ℝ) := by exact_mod_cast weights_checked.2.2
  rw [ha, hb] at hd
  apply le_of_mul_le_mul_left ?_ hc
  unfold P2 Pt
  convert hd using 1 <;> ring

theorem rho_transferred (h2 : mobCell V2 3 (-16) (-15) = MP2)
    (ht : mobCell Vt 3 (-16) (-15) = MPt) {x : ℝ}
    (hx : x ∈ Set.Icc (((-16 : ℤ) : ℝ)/2^3) (((-15 : ℤ) : ℝ)/2^3))
    (hrho : (U2 : ℝ) ≤ P2 x * (1 + (ap : ℝ) + x/2)) :
    (Ut : ℝ) ≤ Pt x * (1 + (ap : ℝ) + x/2) := by
  have hmin : (-2 : ℝ) ≤ ((-16 : ℤ) : ℝ)/2^3 := by norm_num
  have hap : 0 ≤ (ap : ℝ) := by exact_mod_cast signs_checked.2.2
  have hw : 0 ≤ 1 + (ap : ℝ) + x/2 := by linarith [hx.1, hmin]
  have hs2 : 0 < (sr2 : ℝ) := by exact_mod_cast signs_checked.1
  have hst : 0 < (srt : ℝ) := by exact_mod_cast signs_checked.2.1
  have hsame : (sr2 : ℝ) * (U2 : ℝ) = (srt : ℝ) * (Ut : ℝ) := by exact_mod_cast common_checked
  have hh : (srt : ℝ) * (Ut : ℝ) ≤ (sr2 : ℝ) * P2 x * (1 + (ap : ℝ) + x/2) := by
    rw [← hsame, mul_assoc]
    exact mul_le_mul_of_nonneg_left hrho hs2.le
  have hd := rho_transfer_of_dom (weighted_dom h2 ht hx) hw hst hh
  have hc : (srt : ℝ) * (Ut : ℝ) / (srt : ℝ) = (Ut : ℝ) := by
    field_simp [hst.ne']
  simpa only [hc] using hd

end
