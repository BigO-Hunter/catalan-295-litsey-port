module

public import CatalanMeasure.GenD.Signed.Data.Trial72.CostRootData
public import CatalanMeasure.GenD.Signed.Data.Trial72.CostMaximum1

@[expose] public section
set_option Elab.async false
set_option profiler true
set_option maxRecDepth 1000000
set_option maxHeartbeats 0
namespace CatalanMeasure.GenD.Signed.Data.Trial72.CostEndpoint1_04
open CatalanMeasure.Signed.Consts CatalanMeasure.CellCert CatalanMeasure.Signed OAI.InternalCatalan
open CatalanMeasure.GenD.Signed.Data.Trial72 CatalanMeasure.GenD.Signed.Data.Trial
noncomputable section
abbrev bs := CostMaximum1.bs
abbrev coeffs := CostMaximum1.coeffs
theorem coeff_checked : sbPosCoeffs bs 0 = coeffs := CostMaximum1.coeff_checked
theorem positive_checked : coeffs.all (fun c => decide (0 ≤ c)) = true := CostMaximum1.positive_checked
namespace A16
open CostRootData.A16
def sLo : ℚ := (qlist (raw_ints% [, ])).headD 0
def sHi : ℚ := (qlist (raw_ints% [, ])).headD 0
theorem lower_checked : rhoLo * sbHorQ rhoLo coeffs = sLo := by
  -- kcost: 0.461 s measured largest actual120-term endpoint, C31.
  decide +kernel

theorem upper_checked : rhoHi * sbHorQ rhoHi coeffs = sHi := by
  -- kcost: 0.461 s measured conservative same-class120-term endpoint rate, C31.
  decide +kernel

theorem lower_at_endpoint :
    barrierTrialS (bSeq bs) (-(rhoLo : ℝ)) = (sLo : ℝ) := by
  rw [barrierTrialS_horner,coeff_checked,← sbHorQ_cast]
  exact_mod_cast lower_checked

theorem upper_at_endpoint :
    barrierTrialS (bSeq bs) (-(rhoHi : ℝ)) = (sHi : ℝ) := by
  rw [barrierTrialS_horner,coeff_checked,← sbHorQ_cast]
  exact_mod_cast upper_checked

theorem actual_root_enclosure :
    (sLo : ℝ) ≤ barrierTrialS (bSeq bs) (-rho) ∧
      barrierTrialS (bSeq bs) (-rho) ≤ (sHi : ℝ) := by
  have hc : (sbPosCoeffs bs 0).all (fun c => decide (0 ≤ c)) = true := by
    rw [coeff_checked]; exact positive_checked
  have hl0 : (0 : ℝ) ≤ (rhoLo : ℝ) := by exact_mod_cast rhoLo_nonneg
  obtain ⟨hl,hh⟩ := rho_bounds
  constructor
  · rw [← lower_at_endpoint]
    exact barrierTrialS_neg_mono hc hl0 hl
  · rw [← upper_at_endpoint]
    exact barrierTrialS_neg_mono hc (hl0.trans hl) hh

end A16
