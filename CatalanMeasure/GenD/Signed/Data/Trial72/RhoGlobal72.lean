theorem bound0_0 {x : ℝ} (hx : x ∈ Set.Icc (-2 : ℝ) 2) : u0_0 ≤ P0 x * (1+ap0+x/2) := by
  have hw : 0 ≤ 1+ap0+x/2 := by
    have ha : 0 ≤ ap0 := by norm_num [ap0]
    linarith [hx.1]
  have hu : sr0 * u0_0 = sr2 * u2_0 := by norm_num [sr0,sr2,u0_0,u2_0]
  apply le_of_mul_le_mul_left _ sr0_pos
  calc sr0 * u0_0 = sr2 * u2_0 := hu
    _ ≤ sr2 * (P2 x * (1+ap0+x/2)) := mul_le_mul_of_nonneg_left (base0 hx) sr2_pos.le
    _ = (sr2 * P2 x) * (1+ap0+x/2) := by ring
    _ ≤ (sr0 * P0 x) * (1+ap0+x/2) := mul_le_mul_of_nonneg_right (dom0 hx) hw
    _ = sr0 * (P0 x * (1+ap0+x/2)) := by ring

