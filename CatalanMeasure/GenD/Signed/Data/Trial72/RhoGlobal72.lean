theorem coverCases {P : ℝ → Prop}
    (h0 : ∀ {x : ℝ}, x ∈ Set.Icc (((-16 : ℤ) : ℝ)/2^3) (((-15 : ℤ) : ℝ)/2^3) → P x)
    (h1 : ∀ {x : ℝ}, x ∈ Set.Icc (((-15 : ℤ) : ℝ)/2^3) (((-14 : ℤ) : ℝ)/2^3) → P x)
    (h2 : ∀ {x : ℝ}, x ∈ Set.Icc (((-14 : ℤ) : ℝ)/2^3) (((-12 : ℤ) : ℝ)/2^3) → P x)
    (h3 : ∀ {x : ℝ}, x ∈ Set.Icc (((-12 : ℤ) : ℝ)/2^3) (((-8 : ℤ) : ℝ)/2^3) → P x)
    (h4 : ∀ {x : ℝ}, x ∈ Set.Icc (((-8 : ℤ) : ℝ)/2^3) (((0 : ℤ) : ℝ)/2^3) → P x)
    (h5 : ∀ {x : ℝ}, x ∈ Set.Icc (((0 : ℤ) : ℝ)/2^3) (((8 : ℤ) : ℝ)/2^3) → P x)
    (h6 : ∀ {x : ℝ}, x ∈ Set.Icc (((8 : ℤ) : ℝ)/2^3) (((12 : ℤ) : ℝ)/2^3) → P x)
    (h7 : ∀ {x : ℝ}, x ∈ Set.Icc (((12 : ℤ) : ℝ)/2^3) (((14 : ℤ) : ℝ)/2^3) → P x)
    (h8 : ∀ {x : ℝ}, x ∈ Set.Icc (((14 : ℤ) : ℝ)/2^3) (((16 : ℤ) : ℝ)/2^3) → P x)
    {x : ℝ} (hx : x ∈ Set.Icc (-2 : ℝ) 2) : P x := by
  by_cases b0 : x ≤ (((-15 : ℤ) : ℝ)/2^3)
  · apply h0
    constructor
    · convert hx.1 using 1 <;> norm_num
    · exact b0
  by_cases b1 : x ≤ (((-14 : ℤ) : ℝ)/2^3)
  · apply h1
    constructor
    · convert (show (((-15 : ℤ) : ℝ)/2^3) ≤ x from le_of_not_ge b0) using 1 <;> norm_num
    · exact b1
  by_cases b2 : x ≤ (((-12 : ℤ) : ℝ)/2^3)
  · apply h2
    constructor
    · convert (show (((-14 : ℤ) : ℝ)/2^3) ≤ x from le_of_not_ge b1) using 1 <;> norm_num
    · exact b2
  by_cases b3 : x ≤ (((-8 : ℤ) : ℝ)/2^3)
  · apply h3
    constructor
    · convert (show (((-12 : ℤ) : ℝ)/2^3) ≤ x from le_of_not_ge b2) using 1 <;> norm_num
    · exact b3
  by_cases b4 : x ≤ (((0 : ℤ) : ℝ)/2^3)
  · apply h4
    constructor
    · convert (show (((-8 : ℤ) : ℝ)/2^3) ≤ x from le_of_not_ge b3) using 1 <;> norm_num
    · exact b4
  by_cases b5 : x ≤ (((8 : ℤ) : ℝ)/2^3)
  · apply h5
    constructor
    · convert (show (((0 : ℤ) : ℝ)/2^3) ≤ x from le_of_not_ge b4) using 1 <;> norm_num
    · exact b5
  by_cases b6 : x ≤ (((12 : ℤ) : ℝ)/2^3)
  · apply h6
    constructor
    · convert (show (((8 : ℤ) : ℝ)/2^3) ≤ x from le_of_not_ge b5) using 1 <;> norm_num
    · exact b6
  by_cases b7 : x ≤ (((14 : ℤ) : ℝ)/2^3)
  · apply h7
    constructor
    · convert (show (((12 : ℤ) : ℝ)/2^3) ≤ x from le_of_not_ge b6) using 1 <;> norm_num
    · exact b7
  apply h8
  constructor
  · convert (show (((14 : ℤ) : ℝ)/2^3) ≤ x from le_of_not_ge b7) using 1 <;> norm_num
  · convert hx.2 using 1 <;> norm_num

