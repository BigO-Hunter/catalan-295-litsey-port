def rhoLo : ℚ := 1+ap-sqrtHi
def rhoHi : ℚ := 1+ap-sqrtLo
def rho : ℝ := 1+(ap : ℝ)-Real.sqrt ((ap : ℝ)*(2+(ap : ℝ)))

theorem coeff_checked : sbPosCoeffs bs 0 = coeffs := by
  -- kcost: 0.800 s estimated;120 coefficient divisions/scales plus conservative unary sign powers<8000operations.
  decide +kernel

theorem positive_checked : coeffs.all (fun c => decide (0 ≤ c)) = true := by
  -- kcost: 0.012 s estimated;120 rational sign comparisons.
  decide +kernel

theorem lower_checked : rhoLo * sbHorQ rhoLo coeffs = sLo := by
  -- kcost: 0.050 s estimated;120 Horner stages and literal rational construction<500operations;
  -- exact endpoint bit growth is measured by this representative, not assumed cheap.
  decide +kernel

theorem upper_checked : rhoHi * sbHorQ rhoHi coeffs = sHi := by
  -- kcost: 0.050 s estimated;120 Horner stages and literal rational construction<500operations.
  decide +kernel

theorem S1_checked : sbHorQ 1 coeffs = S1 := by
  -- kcost: 0.050 s estimated;120 exact Horner stages at one.
  decide +kernel

theorem sqrt_checked : 0 ≤ ap ∧ 0 ≤ sqrtLo ∧ 0 ≤ sqrtHi ∧
    sqrtLo^2 ≤ ap*(2+ap) ∧ ap*(2+ap) ≤ sqrtHi^2 := by
  -- kcost: 0.003 s estimated;five comparisons plus rational squares/products.
  decide +kernel

theorem rhoLo_nonneg : 0 ≤ rhoLo := by
  -- kcost: 0.001 s estimated;one rational subtraction/sign comparison.
  decide +kernel

theorem rho_bounds : (rhoLo : ℝ) ≤ rho ∧ rho ≤ (rhoHi : ℝ) := by
  obtain ⟨ha,hl,hh,hlo,hhi⟩ := sqrt_checked
  have ha' : (0 : ℝ) ≤ (ap : ℝ) := by exact_mod_cast ha
  have hl' : (0 : ℝ) ≤ (sqrtLo : ℝ) := by exact_mod_cast hl
  have hh' : (0 : ℝ) ≤ (sqrtHi : ℝ) := by exact_mod_cast hh
  have hlo' : (sqrtLo : ℝ)^2 ≤ (ap : ℝ)*(2+(ap : ℝ)) := by exact_mod_cast hlo
  have hhi' : (ap : ℝ)*(2+(ap : ℝ)) ≤ (sqrtHi : ℝ)^2 := by exact_mod_cast hhi
  have h0 : (0 : ℝ) ≤ (ap : ℝ)*(2+(ap : ℝ)) := by positivity
  have hsq := Real.sq_sqrt h0
  have hs0 := Real.sqrt_nonneg ((ap : ℝ)*(2+(ap : ℝ)))
  have hslo : (sqrtLo : ℝ) ≤ Real.sqrt ((ap : ℝ)*(2+(ap : ℝ))) := by
    nlinarith only [hlo',hsq,hl',hs0]
  have hshi : Real.sqrt ((ap : ℝ)*(2+(ap : ℝ))) ≤ (sqrtHi : ℝ) := by
    nlinarith only [hhi',hsq,hh',hs0]
  dsimp only [rhoLo,rhoHi,rho]
  push_cast
  constructor <;> linarith

theorem lower_at_endpoint :
    barrierTrialS (bSeq bs) (-(rhoLo : ℝ)) = (sLo : ℝ) := by
  rw [barrierTrialS_horner,coeff_checked,← sbHorQ_cast]
  exact_mod_cast lower_checked

theorem upper_at_endpoint :
    barrierTrialS (bSeq bs) (-(rhoHi : ℝ)) = (sHi : ℝ) := by
  rw [barrierTrialS_horner,coeff_checked,← sbHorQ_cast]
  exact_mod_cast upper_checked

theorem at_one : barrierTrialS (bSeq bs) (-1) = (S1 : ℝ) := by
  rw [barrierTrialS_horner,coeff_checked]
  have he : ((sbHorQ 1 coeffs : ℚ) : ℝ) = CatalanMeasure.Cert.lpEval coeffs 1 := by
    simpa only [Rat.cast_one] using sbHorQ_cast (1 : ℚ) coeffs
  rw [← he]
  simp only [one_mul]
  exact_mod_cast S1_checked

theorem global_maximum : ∀ y ∈ Set.Icc (0 : ℝ) 1,
    2*barrierTrialS (bSeq bs) (-y) ≤ 2*(S1 : ℝ) := by
  intro y hy
  have hc : (sbPosCoeffs bs 0).all (fun c => decide (0 ≤ c)) = true := by
    rw [coeff_checked]; exact positive_checked
  have h := barrierTrialS_neg_mono hc hy.1 hy.2
  rw [at_one] at h
  linarith

theorem actual_root_enclosure :
    (sLo : ℝ) ≤ barrierTrialS (bSeq bs) (-rho) ∧
      barrierTrialS (bSeq bs) (-rho) ≤ (sHi : ℝ) := by
  have hc : (sbPosCoeffs bs 0).all (fun c => decide (0 ≤ c)) = true := by
    rw [coeff_checked]; exact positive_checked
  have hl0 : (0 : ℝ) ≤ (rhoLo : ℝ) := by exact_mod_cast rhoLo_nonneg
  obtain ⟨hl,hh⟩ := rho_bounds
  constructor
  · rw [← lower_at_endpoint]
    exact barrierTrialS_neg_mono hc hl0 hl
  · rw [← upper_at_endpoint]
    exact barrierTrialS_neg_mono hc (hl0.trans hl) hh

