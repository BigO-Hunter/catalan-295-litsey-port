/-! ### Cells and entries from integer triples -/

/-- Integer triple `(a, b, p)`: cell `[a, b] / 10^12` of integer weight `p`. -/
abbrev Tr := ℤ × ℤ × ℤ

def trip (A B P : List ℤ) : List Tr := A.zip (B.zip P)

/-- Sum of the integer weights. -/
def sumP (L : List Tr) : ℤ := (L.map fun t => t.2.2).sum

open Classical in
/-- The cell `[a/10^12, b/10^12]` of mass `m * p / T`. -/
def mkCell (m : ℝ) (T : ℤ) (t : Tr) : YCell :=
  if h : t.1 < t.2.1 ∧ 0 ≤ t.2.2 ∧ 0 ≤ T ∧ 0 ≤ m then
    { lo := (t.1 : ℝ) / 10 ^ 12
      hi := (t.2.1 : ℝ) / 10 ^ 12
      w := m * (t.2.2 : ℝ) / (T : ℝ)
      lo_lt := by
        have h1 : (t.1 : ℝ) < t.2.1 := by exact_mod_cast h.1
        gcongr
      w_nonneg := by
        have h2 : (0 : ℝ) ≤ t.2.2 := by exact_mod_cast h.2.1
        have h3 : (0 : ℝ) ≤ T := by exact_mod_cast h.2.2.1
        exact div_nonneg (mul_nonneg h.2.2.2 h2) h3 }
  else { lo := 0, hi := 1, w := 0, lo_lt := zero_lt_one, w_nonneg := le_rfl }

theorem mkCell_eq {m : ℝ} {T : ℤ} {t : Tr} (hv : t.1 < t.2.1 ∧ 0 ≤ t.2.2) (hT : 0 ≤ T)
    (hm : 0 ≤ m) :
    (mkCell m T t).lo = (t.1 : ℝ) / 10 ^ 12 ∧ (mkCell m T t).hi = (t.2.1 : ℝ) / 10 ^ 12 ∧
      (mkCell m T t).w = m * (t.2.2 : ℝ) / (T : ℝ) := by
  have h : t.1 < t.2.1 ∧ 0 ≤ t.2.2 ∧ 0 ≤ T ∧ 0 ≤ m := ⟨hv.1, hv.2, hT, hm⟩
  unfold mkCell
  rw [dif_pos h]
  exact ⟨rfl, rfl, rfl⟩

theorem massL_map_mkCell {m : ℝ} {T : ℤ} (hT : 0 ≤ T) (hm : 0 ≤ m) :
    ∀ L : List Tr, (∀ t ∈ L, t.1 < t.2.1 ∧ 0 ≤ t.2.2) →
      massL (L.map (mkCell m T)) = m * (sumP L : ℝ) / (T : ℝ)
  | [], _ => by simp [massL, sumP]
  | t :: L, hv => by
    have ih := massL_map_mkCell hT hm L (fun s hs => hv s (List.mem_cons_of_mem _ hs))
    have h := (mkCell_eq (hv t List.mem_cons_self) hT hm).2.2
    have e1 : massL ((t :: L).map (mkCell m T)) =
        (mkCell m T t).w + massL (L.map (mkCell m T)) := by simp [massL]
    have e2 : sumP (t :: L) = t.2.2 + sumP L := by simp [sumP]
    rw [e1, ih, h, e2]
    push_cast
    ring

theorem cell_lo_ge {m : ℝ} {T : ℤ} {t : Tr} (hv : t.1 < t.2.1 ∧ 0 ≤ t.2.2) (hT : 0 ≤ T)
    (hm : 0 ≤ m) (h2 : 2000000000000 ≤ t.1) : 2 ≤ (mkCell m T t).lo := by
  rw [(mkCell_eq hv hT hm).1, le_div_iff₀ (by positivity)]
  have : (2000000000000 : ℝ) ≤ t.1 := by exact_mod_cast h2
  norm_num
  exact this

theorem cell_hi_le {m : ℝ} {T : ℤ} {t : Tr} (hv : t.1 < t.2.1 ∧ 0 ≤ t.2.2) (hT : 0 ≤ T)
    (hm : 0 ≤ m) (h2 : t.2.1 ≤ -2000000000000) : (mkCell m T t).hi ≤ -2 := by
  rw [(mkCell_eq hv hT hm).2.1, div_le_iff₀ (by positivity)]
  have : (t.2.1 : ℝ) ≤ -2000000000000 := by exact_mod_cast h2
  norm_num
  exact this

open Classical in
/-- Auxiliary entry: radius index `i`, phase `pi j / 93`, weight `g * p / M`. -/
def mkAux (g : ℝ) (M : ℤ) (t : Tr) : AuxEntry :=
  if h : 0 ≤ t.2.2 ∧ 0 ≤ M ∧ 0 ≤ g then
    { rad := t.1.toNat
      phase := Real.pi * (t.2.1 : ℝ) / 93
      w := g * (t.2.2 : ℝ) / (M : ℝ)
      w_nonneg := by
        have h2 : (0 : ℝ) ≤ t.2.2 := by exact_mod_cast h.1
        have h3 : (0 : ℝ) ≤ M := by exact_mod_cast h.2.1
        exact div_nonneg (mul_nonneg h.2.2 h2) h3 }
  else { rad := 0, phase := 0, w := 0, w_nonneg := le_rfl }

theorem auxW_sum {g : ℝ} {M : ℤ} (hM : 0 ≤ M) (hg : 0 ≤ g) :
    ∀ L : List Tr, (∀ t ∈ L, 0 ≤ t.2.2) →
      ((L.map (mkAux g M)).map fun e => e.w).sum = g * (sumP L : ℝ) / (M : ℝ)
  | [], _ => by simp [sumP]
  | t :: L, hv => by
    have ih := auxW_sum hM hg L (fun s hs => hv s (List.mem_cons_of_mem _ hs))
    have h : (mkAux g M t).w = g * (t.2.2 : ℝ) / (M : ℝ) := by
      have hh : 0 ≤ t.2.2 ∧ 0 ≤ M ∧ 0 ≤ g := ⟨hv t List.mem_cons_self, hM, hg⟩
      unfold mkAux
      rw [dif_pos hh]
    have e2 : sumP (t :: L) = t.2.2 + sumP L := by simp [sumP]
    simp only [List.map_cons, List.sum_cons]
    rw [ih, h, e2]
    push_cast
    ring

theorem mkAux_rad_lt (g : ℝ) (M : ℤ) (t : Tr) (h : t.1 < 16) : (mkAux g M t).rad < 16 := by
  unfold mkAux
  split_ifs
  · show t.1.toNat < 16
    omega
  · show 0 < 16
    norm_num

/-! ### The source record -/

def isPos (t : Tr) : Bool := decide (0 ≤ t.1)

def row0 : List Tr := trip row0A row0B row0P
def col0 : List Tr := trip col0A col0B col0P
def row1 : List Tr := trip row1A row1B row1P
def col1 : List Tr := trip col1A col1B col1P
def gasPosT : List Tr := row0.filter isPos
def gasNegT : List Tr := row0.filter fun t => !isPos t
def paT : List Tr := trip paI paJ paP
def naT : List Tr := trip naI naJ naP

/-- The species-`σ` cube cells (the same normalization `1 / sum p` for both species). -/
def gasCells : Sign → List YCell
  | Sign.pos => gasPosT.map (mkCell 1 (sumP row0))
  | Sign.neg => gasNegT.map (mkCell 1 (sumP row0))

def refRowF (a : Fin 2) : List YCell :=
  if a = 0 then row0.map (mkCell 1 (sumP row0)) else row1.map (mkCell (49 / 50) (sumP row1))

def refColF (a : Fin 2) : List YCell :=
  if a = 0 then col0.map (mkCell 1 (sumP col0)) else col1.map (mkCell (49 / 50) (sumP col1))

def auxT : Sign → List Tr
  | Sign.pos => paT
  | Sign.neg => naT

/-- Auxiliary total mass: `1 - m_+` (positive), `53/58 - m_-` (negative). -/
def tgt : Sign → ℝ
  | Sign.pos => 1 - massL (gasCells Sign.pos)
  | Sign.neg => 53 / 58 - massL (gasCells Sign.neg)

def auxCells (σ : Sign) : List AuxEntry := (auxT σ).map (mkAux (tgt σ) (sumP (auxT σ)))

/-- `sigma_i` (constant after the last index). -/
def sigmaF (i : ℕ) : ℝ := (sigN.getD (min i 15) 0 : ℝ) / 10 ^ 17
def radialF (i : ℕ) : ℝ := (radN.getD (min i 15) 0 : ℝ) / 10 ^ 17

/-- THE source of the certified 198-cap run. -/
def capSource : CapSource where
  gas := gasCells
  refRow := refRowF
  refCol := refColF
  aux := auxCells
  sigma := sigmaF
  radial := radialF
  nRad := 16
  eps := 27 / 250

/-! ### Data checks (exact integer arithmetic, `decide +kernel`) -/

theorem row0_ok : ∀ t ∈ row0, t.1 < t.2.1 ∧ 0 ≤ t.2.2 := by decide +kernel
theorem col0_ok : ∀ t ∈ col0, t.1 < t.2.1 ∧ 0 ≤ t.2.2 := by decide +kernel
theorem row1_ok : ∀ t ∈ row1, t.1 < t.2.1 ∧ 0 ≤ t.2.2 := by decide +kernel
theorem col1_ok : ∀ t ∈ col1, t.1 < t.2.1 ∧ 0 ≤ t.2.2 := by decide +kernel

theorem row0_away : ∀ t ∈ row0,
    (0 ≤ t.1 → 2000000000000 ≤ t.1) ∧ (t.1 < 0 → t.2.1 ≤ -2000000000000) := by decide +kernel
theorem row1_away : ∀ t ∈ row1,
    (0 ≤ t.1 → 2000000000000 ≤ t.1) ∧ (t.1 < 0 → t.2.1 ≤ -2000000000000) := by decide +kernel

theorem row0_tot : 0 < sumP row0 := by decide +kernel
theorem col0_tot : 0 < sumP col0 := by decide +kernel
theorem row1_tot : 0 < sumP row1 := by decide +kernel
theorem col1_tot : 0 < sumP col1 := by decide +kernel

theorem pos_le_tot : sumP gasPosT ≤ sumP row0 := by decide +kernel
theorem neg_le_tot : 58 * sumP gasNegT ≤ 53 * sumP row0 := by decide +kernel
theorem pos_ge : 63 * sumP row0 ≤ 100 * sumP gasPosT := by decide +kernel

theorem pa_ok : ∀ t ∈ paT, 0 ≤ t.2.2 ∧ t.1 < 16 := by decide +kernel
theorem na_ok : ∀ t ∈ naT, 0 ≤ t.2.2 ∧ t.1 < 16 := by decide +kernel
theorem pa_tot : 0 < sumP paT := by decide +kernel
theorem na_tot : 0 < sumP naT := by decide +kernel

theorem sig_nonneg : ∀ n < 16, 0 ≤ sigN.getD n 0 := by decide +kernel
theorem sig_mono : ∀ n < 15, sigN.getD n 0 ≤ sigN.getD (n + 1) 0 := by decide +kernel

/-! ### Bridges -/

theorem sum_split_gen (L : List Tr) :
    sumP (L.filter isPos) + sumP (L.filter fun t => !isPos t) = sumP L := by
  have := ((List.filter_append_perm isPos L).map (fun t : Tr => t.2.2)).sum_eq
  simp only [sumP, ← List.sum_append, ← List.map_append]
  exact this

theorem sum_split : sumP gasPosT + sumP gasNegT = sumP row0 := sum_split_gen row0

theorem massPos : massL (gasCells Sign.pos) = (sumP gasPosT : ℝ) / (sumP row0 : ℝ) := by
  have hT : (0 : ℤ) ≤ sumP row0 := row0_tot.le
  have := massL_map_mkCell (m := 1) hT zero_le_one gasPosT
    (fun t ht => row0_ok t (List.mem_of_mem_filter ht))
  simpa [gasCells] using this

theorem massNeg : massL (gasCells Sign.neg) = (sumP gasNegT : ℝ) / (sumP row0 : ℝ) := by
  have hT : (0 : ℤ) ≤ sumP row0 := row0_tot.le
  have := massL_map_mkCell (m := 1) hT zero_le_one gasNegT
    (fun t ht => row0_ok t (List.mem_of_mem_filter ht))
  simpa [gasCells] using this

theorem tot_ne : (sumP row0 : ℝ) ≠ 0 := by exact_mod_cast row0_tot.ne'

theorem tgt_nonneg (σ : Sign) : 0 ≤ tgt σ := by
  have hT : (0 : ℝ) < sumP row0 := by exact_mod_cast row0_tot
  cases σ
  · simp only [tgt]
    rw [massNeg, sub_nonneg, div_le_div_iff₀ hT (by norm_num)]
    have : (58 : ℝ) * sumP gasNegT ≤ 53 * sumP row0 := by exact_mod_cast neg_le_tot
    linarith
  · simp only [tgt]
    rw [massPos, sub_nonneg, div_le_one hT]
    exact_mod_cast pos_le_tot

theorem auxMass_eq (σ : Sign) : capSource.auxMass σ = tgt σ := by
  have hpos : ∀ σ, 0 < sumP (auxT σ) := by
    intro σ; cases σ
    · exact na_tot
    · exact pa_tot
  have hnn : ∀ σ, ∀ t ∈ auxT σ, 0 ≤ t.2.2 := by
    intro σ; cases σ
    · exact fun t ht => (na_ok t ht).1
    · exact fun t ht => (pa_ok t ht).1
  have h := auxW_sum (g := tgt σ) (M := sumP (auxT σ)) (hpos σ).le (tgt_nonneg σ) (auxT σ) (hnn σ)
  have hM : (sumP (auxT σ) : ℝ) ≠ 0 := by exact_mod_cast (hpos σ).ne'
  show ((auxCells σ).map fun e => e.w).sum = tgt σ
  rw [auxCells, h]
  field_simp

theorem gas_pos_lo : ∀ c ∈ gasCells Sign.pos, 2 ≤ c.lo := by
  intro c hc
  obtain ⟨t, ht', rfl⟩ := List.mem_map.1 hc
  obtain ⟨ht, hp⟩ := List.mem_filter.1 (show t ∈ row0.filter isPos from ht')
  have hnn : 0 ≤ t.1 := by simpa [isPos] using hp
  exact cell_lo_ge (row0_ok t ht) row0_tot.le zero_le_one ((row0_away t ht).1 hnn)

theorem gas_neg_hi : ∀ c ∈ gasCells Sign.neg, c.hi ≤ -2 := by
  intro c hc
  obtain ⟨t, ht', rfl⟩ := List.mem_map.1 hc
  obtain ⟨ht, hp⟩ := List.mem_filter.1 (show t ∈ row0.filter fun t => !isPos t from ht')
  have hnn : t.1 < 0 := by simpa [isPos] using hp
  exact cell_hi_le (row0_ok t ht) row0_tot.le zero_le_one ((row0_away t ht).2 hnn)

theorem ref_away_row (m : ℝ) (hm : 0 ≤ m) (L : List Tr) (T : ℤ) (hT : 0 ≤ T)
    (hok : ∀ t ∈ L, t.1 < t.2.1 ∧ 0 ≤ t.2.2)
    (haw : ∀ t ∈ L, (0 ≤ t.1 → 2000000000000 ≤ t.1) ∧ (t.1 < 0 → t.2.1 ≤ -2000000000000)) :
    ∀ c ∈ L.map (mkCell m T), 2 ≤ c.lo ∨ c.hi ≤ -2 := by
  intro c hc
  obtain ⟨t, ht, rfl⟩ := List.mem_map.1 hc
  by_cases h0 : 0 ≤ t.1
  · exact Or.inl (cell_lo_ge (hok t ht) hT hm ((haw t ht).1 h0))
  · exact Or.inr (cell_hi_le (hok t ht) hT hm ((haw t ht).2 (not_le.1 h0)))

theorem sigma_nonneg_thm : ∀ i, 0 ≤ capSource.sigma i := by
  intro i
  show 0 ≤ (sigN.getD (min i 15) 0 : ℝ) / 10 ^ 17
  have : 0 ≤ sigN.getD (min i 15) 0 := sig_nonneg _ (by omega)
  have h' : (0 : ℝ) ≤ (sigN.getD (min i 15) 0 : ℝ) := by exact_mod_cast this
  positivity

theorem sigma_mono_thm : Monotone capSource.sigma := by
  apply monotone_nat_of_le_succ
  intro n
  show (sigN.getD (min n 15) 0 : ℝ) / 10 ^ 17 ≤ (sigN.getD (min (n + 1) 15) 0 : ℝ) / 10 ^ 17
  by_cases h : n < 15
  · have h1 : min n 15 = n := by omega
    have h2 : min (n + 1) 15 = n + 1 := by omega
    rw [h1, h2]
    have : (sigN.getD n 0 : ℝ) ≤ sigN.getD (n + 1) 0 := by exact_mod_cast sig_mono n h
    gcongr
  · have h1 : min n 15 = 15 := by omega
    have h2 : min (n + 1) 15 = 15 := by omega
    rw [h1, h2]

theorem capSource_admissible : capSource.Admissible where
  eps_pos := by show (0 : ℝ) < 27 / 250; norm_num
  sigma_nonneg := sigma_nonneg_thm
  sigma_mono := sigma_mono_thm
  aux_rad := by
    intro σ e he
    simp only [capSource, auxCells, List.mem_map] at he
    obtain ⟨t, ht, rfl⟩ := he
    apply mkAux_rad_lt
    cases σ
    · exact (na_ok t ht).2
    · exact (pa_ok t ht).2
  gas_pos := gas_pos_lo
  gas_neg := gas_neg_hi
  ref_away := by
    intro a
    fin_cases a
    · exact ref_away_row 1 zero_le_one row0 _ row0_tot.le row0_ok row0_away
    · exact ref_away_row (49 / 50) (by norm_num) row1 _ row1_tot.le row1_ok row1_away
  gas_mass := by
    show massL (gasCells Sign.pos) + massL (gasCells Sign.neg) = 1
    rw [massPos, massNeg, ← add_div]
    have : ((sumP gasPosT : ℤ) : ℝ) + ((sumP gasNegT : ℤ) : ℝ) = (sumP row0 : ℝ) := by
      exact_mod_cast sum_split
    rw [this, div_self tot_ne]
  aux_pos_mass := auxMass_eq Sign.pos
  aux_neg_mass := auxMass_eq Sign.neg
  ref0_perm := by
    show (row0.map (mkCell 1 (sumP row0))).Perm
      (gasPosT.map (mkCell 1 (sumP row0)) ++ gasNegT.map (mkCell 1 (sumP row0)))
    rw [← List.map_append]
    exact ((List.filter_append_perm isPos row0).map (mkCell 1 (sumP row0))).symm
  ref_row_mass0 := by
    have h := massL_map_mkCell (m := 1) row0_tot.le zero_le_one row0 row0_ok
    have hT : (sumP row0 : ℝ) ≠ 0 := tot_ne
    have e : refRowF 0 = row0.map (mkCell 1 (sumP row0)) := if_pos rfl
    show massL (refRowF 0) = 1
    rw [e, h]; field_simp
  ref_col_mass0 := by
    have h := massL_map_mkCell (m := 1) col0_tot.le zero_le_one col0 col0_ok
    have hT : (sumP col0 : ℝ) ≠ 0 := by exact_mod_cast col0_tot.ne'
    have e : refColF 0 = col0.map (mkCell 1 (sumP col0)) := if_pos rfl
    show massL (refColF 0) = 1
    rw [e, h]; field_simp
  ref_row_mass1 := by
    have h := massL_map_mkCell (m := 49 / 50) row1_tot.le (by norm_num) row1 row1_ok
    have hT : (sumP row1 : ℝ) ≠ 0 := by exact_mod_cast row1_tot.ne'
    have e : refRowF 1 = row1.map (mkCell (49 / 50) (sumP row1)) :=
      if_neg (by decide)
    show massL (refRowF 1) = 49 / 50
    rw [e, h]; field_simp
  ref_col_mass1 := by
    have h := massL_map_mkCell (m := 49 / 50) col1_tot.le (by norm_num) col1 col1_ok
    have hT : (sumP col1 : ℝ) ≠ 0 := by exact_mod_cast col1_tot.ne'
    have e : refColF 1 = col1.map (mkCell (49 / 50) (sumP col1)) :=
      if_neg (by decide)
    show massL (refColF 1) = 49 / 50
    rw [e, h]; field_simp

/-! ### Numeric facts consumed by the cap rows -/

theorem capSource_eps_ge : (1 : ℝ) / 10 ≤ capSource.eps := by
  show (1 : ℝ) / 10 ≤ 27 / 250; norm_num

theorem capSource_eps_le : capSource.eps ≤ 3 / 20 := by
  show (27 : ℝ) / 250 ≤ 3 / 20; norm_num

theorem capSource_massL_pos_ge : (63 : ℝ) / 100 ≤ massL (capSource.gas Sign.pos) := by
  show (63 : ℝ) / 100 ≤ massL (gasCells Sign.pos)
  have hT : (0 : ℝ) < sumP row0 := by exact_mod_cast row0_tot
  rw [massPos, le_div_iff₀ hT]
  have : (63 : ℝ) * sumP row0 ≤ 100 * sumP gasPosT := by exact_mod_cast pos_ge
  linarith

end

