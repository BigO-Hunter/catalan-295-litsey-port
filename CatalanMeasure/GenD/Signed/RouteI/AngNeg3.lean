  decide +kernel

theorem hgl_ne : glL ≠ [] := by
  -- kcost: one constructor test.
  decide +kernel

theorem aux_rad : AngAux.auxRadCheck Sign.neg 26 3 DD = true := by
  -- kcost: 32 streams, 2 exp enclosures of 26 terms each; under 1 s.
  decide +kernel

theorem haux_eq : AngAux.auxList Sign.neg 3 DD = auxL := by
  -- kcost: 32 streams x 384 steps, 385 Rat floors; about 6 s at 32 streams (measured).
  decide +kernel

theorem heps : eGneg 192 127 Hb1 Hb2 cbb1 cbb2 + AngAux.eAq Sign.neg DD + AngAux.tailQ Sign.neg DD.sh ≤ epsQ := by
  -- kcost: 2 x 32-term rational sums, one rational 385th power; under 1 s.
  decide +kernel

theorem hconv : AngularCap.combineP (AngularCap.Nlist glL) auxL (2 ^ 192 * 2 ^ (glL.length - 1)) AngAux.adN = pL := by
  -- kcost: Nlist on 128 coefficients, O(128^2) big additions; about 1 s (measured).
  decide +kernel

theorem hkron : KronSquare.KronSquare KD pL qL [] rL ((2 ^ 192 * 2 ^ (glL.length - 1)) * AngAux.adN) (5489/100000) epsQ := by
  -- kcost: packed square of 256 coefficients at 770 bits and a 511-term identity; about 11 s (measured).
  decide +kernel

open CatalanMeasure.Signed.ChebSquare in
theorem hmarg : l1 rL.tail < rL.headD 0 := by
  -- kcost: 511 absolute values; about 1 s (measured).
  decide +kernel

theorem gas_ok : AngularSource.Binning (capSource.gas Sign.neg) ((binsY TL).map reflectL) ∧
    ∑ j ∈ Finset.range (127 + 1), |AngularCap.gasA capSource Sign.neg 3 ((binsY TL).map reflectL) j -
      (((glFastNeg 192 alD al2D (TL.map BD.s0) cnumD 127).getD j 0 : ℤ) : ℝ) / ((2 ^ 192 : ℕ) : ℝ)| ≤
    ((eGneg 192 127 Hb1 Hb2 cbb1 cbb2 : ℚ) : ℝ) :=
  gas_final_neg capSource 3 part_neg capSource_neg_hi (capSource_neg_w CatalanMeasure.GenD.Signed.RouteI.AngMomNeg16.gasw_pos) mom_spec
    (rad_enc capSource 3 (capSource_sigma 3) rad_ok) a1_ok a2_ok const_ok cb1_ok cb2_ok 127

/-- **The certificate** of the negative species at radius index 3. -/
def angNeg3 : AngularCap.AngRadiusCert capSource Sign.neg 3 (5489/100000) :=
  AngAux.angRadius_of_kron Sign.neg 3 26 (5489/100000) ((binsY TL).map reflectL) gas_ok.1 127 (by decide)
    glL (2 ^ 192) (by positivity) hgl_len hgl_ne (eGneg 192 127 Hb1 Hb2 cbb1 cbb2)
    (by rw [← hgl_eq]; exact gas_ok.2)
    DD shared_ok (AngAux.auxRadOK_of_check aux_rad) auxL pL qL [] rL haux_eq epsQ heps hconv KD hkron hmarg

end

end CatalanMeasure.GenD.Signed.RouteI.AngNeg3
